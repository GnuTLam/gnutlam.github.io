---
/* one folder, one look — the SAME full-width bar renders a directory at
   every level: the tree, the "../" up entry, any future nested folder.
   Extra attributes (aria-*, data-*) pass straight through so the
   categories index can use it as an accordion header without a second
   variant. */
import { FOLDER_CLOSED, FOLDER_OPEN, FM_PAL, pxSvg } from '../../data/pixel';

interface Props {
  href: string;
  name: string;
  count?: string;
  desc?: string;
  tone?: string;
  class?: string;
  [key: string]: unknown;
}

const { href, name, count, desc, tone, class: className, ...rest } = Astro.props;
/* 28, not 30: the art is now 14x11 instead of 14x9, so the same width would
   have grown the row. 28 keeps the bar height where it was and still reads
   as a folder rather than a slab. */
const closed = pxSvg(FOLDER_CLOSED, FM_PAL, 28);
const open = pxSvg(FOLDER_OPEN, FM_PAL, 28);
---

<a
  class:list={['fm-dir', className]}
  href={href}
  style={tone ? `--tc: ${tone}` : undefined}
  {...rest}
>
  <span class="fm-ico">
    <span class="ico-closed" set:html={closed} />
    <span class="ico-open" set:html={open} />
  </span>
  <b class="fm-name">{name}</b>
  {desc && <span class="fm-dd">{desc}</span>}
  {count && <span class="fm-n">{count}</span>}
</a>
