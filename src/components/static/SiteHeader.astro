---
/* SiteHeader — the GNUT/OS top panel, i3bar + waybar:
   [▦ launcher] [1 main][2 posts]… (active = solid red block) ··· load · rss · theme · null | clock
   Everything cut from the bar stays reachable via rofi / footer. */
import { NAV } from '../../data/nav.ts';
import { getPublishedPosts } from '../../data/posts';
import { topicOf } from '../../data/topics';
import { SITE } from '../../data/site';
import { pxSvg, pxSquare, pxGrid, SKULL_FACE, HACKER_PAL, GNUT_MARK, GNUT_PAL_FULL } from '../../data/pixel';

interface Props {
  active: string;
}
const { active } = Astro.props;

const posts = await getPublishedPosts();

/* pixel-file icons for the tray and the workspace tabs */
/* `k` (every icon's outline) and `d` (the term icon's screen body) are the two
   colours that decide whether an icon has a readable EDGE on the panel behind
   it. Hard-coded near-black, they measured 1.11:1 and 1.10:1 against the dark
   bar — the outline simply vanished and the glyphs read as soft blobs. They
   are tokens now, flipped per palette in theme.css. The rest are saturated
   colours that already read on both. */
const ICO_PAL: Record<string, string> = {
  k: 'var(--ico-line)', w: '#f2ede0', y: '#dcb25e', o: '#cf7a52', e: '#ffffff',
  t: '#3fbfae', g: '#9aa48f', d: 'var(--ico-screen)', G: '#7fbf78', b: '#4f9de0',
  Y: '#f2d675',
};
const ICO: Record<string, string[]> = {
  /* Every art below is drawn to its OBJECT's real proportion — a sheet of
     paper and a bin are TALLER than wide, a screen is 4:3, a badge is square.
     They used to be 1.2-1.6x wider than tall, and that squat art is what read
     as "squashed": the renderer was faithfully keeping the aspect it was given. */
  rss: [                             /* badge — square, 11x11 */
    'kkkkkkkkkkk',
    'kwwwwwwwwwk',
    'kwooooowwwk',
    'kwwwwwwoowk',
    'kwooowwwowk',
    'kwwwwowwowk',
    'kwoowwowowk',
    'kwoowwowowk',
    'kwoowwowowk',
    'kwwwwwwwwwk',
    'kkkkkkkkkkk',
  ],
  conf: [                            /* lightbulb — already square, 10x10 */
    '....kkkk....',
    '..kkYYYYkk..',
    '.kYYYYYYYYk.',
    '.kYeeYYYYYk.',
    '.kYeYYYYYYk.',
    '.kYYYYYYYYk.',
    '..kYYYYYYk..',
    '...kYYYYk...',
    '...kggggk...',
    '....kggk....',
  ],
  trash: [                           /* bin — upright, 9x11 */
    '..kkkkk..',
    'kkkkkkkkk',
    'kwwwwwwwk',
    '.kgwgwgk.',
    '.kgwgwgk.',
    '.kgwgwgk.',
    '.kgwgwgk.',
    '.kgwgwgk.',
    '.kgwgwgk.',
    '.kgwgwgk.',
    '..kkkkk..',
  ],
  /* app icons for the workspace tabs */
  term: [                            /* screen — 4:3, 12x9 */
    'kkkkkkkkkkkk',
    'kddddddddddk',
    'kdGwdddddddk',
    'kddGwddddddk',
    'kdGwdddddddk',
    'kdddGGGddddk',
    'kddddddddddk',
    'kddddddddddk',
    'kkkkkkkkkkkk',
  ],
  doc: [                             /* sheet of paper — portrait, 9x12 */
    'kkkkkkk..',
    'kwwwwwkk.',
    'kwwwwwwkk',
    'kwbbbwwwk',
    'kwwwwwwwk',
    'kwbbbbwwk',
    'kwwwwwwwk',
    'kwbbbwwwk',
    'kwwwwwwwk',
    'kwbbbbwwk',
    'kwwwwwwwk',
    'kkkkkkkkk',
  ],
  folder: [                          /* folder — 11x9, a body instead of a slab */
    '.kkkk......',
    'kyyyykkkkk.',
    'kyyyyyyyyyk',
    'kywwwwwwwyk',
    'kyyyyyyyyyk',
    'kyyyyyyyyyk',
    'kyyyyyyyyyk',
    'kyyyyyyyyyk',
    'kkkkkkkkkkk',
  ],
  tag: [                             /* label — 11x10 */
    '....kkkkkkk',
    '...kbbbbbbk',
    '..kbbwwbbbk',
    '.kbbwkkwbbk',
    'kbbbwwbbbbk',
    'kbbbbbbbbbk',
    'kbbbbbbbbk.',
    '.kbbbbbbk..',
    '..kbbbbk...',
    '...kkkk....',
  ],
};
const APP_ICO: Record<string, string[]> = {
  main: ICO.term, posts: ICO.doc, categories: ICO.folder, tags: ICO.tag,
};
/* every panel icon shares ONE square grid (the widest bounding box in the
   set) and renders at a whole number of px per art pixel, so the bar is
   uniform because the BOX is uniform — not because each art was stretched
   to fill a square, which is what made these icons blurry and misshapen. */
const BAR_GRID = pxGrid(...Object.values(ICO));
const barIcon = (cells: string[]) => pxSquare(cells, ICO_PAL, 24, BAR_GRID);
/* the about tab is the operator, so it wears the mascot's face — cropped from
   the About avatar's own pixels, in its own fixed palette (ICO_PAL's outline
   is --ico-line, which would turn the sockets light in dark mode) */
const tabIcon = (key: string) => key === 'about'
  ? pxSquare(SKULL_FACE, HACKER_PAL, 24, BAR_GRID)
  : barIcon(APP_ICO[key] ?? ICO.term);
/* the launcher is the brand: the whole mascot in full colour (headphones and
   all, at 2px cells = 32x34 in the 48px bar) beside the OS wordmark. It is not
   the about tab's cropped face, and it carries no red block of its own — in
   the bar red means "the focused workspace" and nothing else. */
const launcherMark = pxSvg(GNUT_MARK, GNUT_PAL_FULL, 32);

/* rofi is the deliberate superset: workspaces → posts → files/actions → poweroff */
const ROFI = [
  ...NAV.map((n, i) => ({ k: 'goto', t: `${n.label.toLowerCase()}  —  workspace ${i + 1}`, href: n.href, tc: '' })),
  ...posts.map(p => ({
    k: 'post',
    t: p.title,
    href: `/posts/${p.slug}/`,
    tc: topicOf(p.tags).tone,
    x: p.tags.join(' '),
  })),
  { k: 'feed',  t: 'rss.xml — subscribe', href: '/rss.xml', tc: '' },
  { k: 'conf',  t: 'theme.conf — dark | light', href: '!theme', tc: '' },
  { k: 'sys',   t: 'systemctl poweroff', href: '!halt', tc: '' },
];
---
<nav class="bar" aria-label="Top panel">
  <button class="bar-menu" id="bar-menu" type="button" title="Launcher" aria-haspopup="dialog">
    <span class="l" aria-hidden set:html={launcherMark}></span>
    <b class="bar-brand">{SITE.osName}</b>
  </button>
  <div class="bar-ws" aria-label="Workspaces">
    {NAV.map(n => (
      <a
        href={n.href}
        class={`ws-btn${active === n.key ? ' on' : ''}`}
        title={n.label.toLowerCase()}
        aria-current={active === n.key ? 'page' : undefined}
      >
        <span class="ico" aria-hidden set:html={tabIcon(n.key)} />
        <span class="t">{n.label.toLowerCase()}</span>
      </a>
    ))}
  </div>
  <div class="bar-tray">
    <a class="bar-ico" href="/rss.xml" title="RSS feed" aria-label="RSS feed"><span class="ico" aria-hidden set:html={barIcon(ICO.rss)} /></a>
    <button class="bar-ico" id="bar-conf" type="button" title="Theme" aria-label="Theme settings"><span class="ico" aria-hidden set:html={barIcon(ICO.conf)} /></button>
    <a class="bar-ico" href="/dev-null/" title="/dev/null — deleted drafts" aria-label="/dev/null — deleted drafts"><span class="ico" aria-hidden set:html={barIcon(ICO.trash)} /></a>
    <span class="bar-sep" aria-hidden></span>
    <span class="bar-seg s-clock" id="bar-clock" aria-hidden></span>
  </div>
</nav>

<div class="rofi" id="rofi" role="dialog" aria-label="Launcher" aria-modal="true">
  <div class="rofi-box">
    <div class="rofi-input">
      <b aria-hidden>run:</b>
      <input id="rofi-q" placeholder="jump to a workspace or search posts…" spellcheck="false" autocomplete="off" aria-label="Search" />
    </div>
    <div class="rofi-list" id="rofi-list" role="listbox"></div>
    <div class="rofi-hint" aria-hidden>
      <span><b>↑↓</b> select</span><span><b class="mono">↵</b> open</span><span><b>esc</b> close</span>
    </div>
  </div>
</div>

<div class="halt" id="halt" role="button" tabindex="-1">
  <pre>[  OK  ] Reached target Power-Off.</pre>
  <b>System halted.</b>
  <span style="font-size:0.8em; opacity:0.7">(click anywhere to reboot {SITE.osName})</span>
</div>

<script is:inline set:html={`window.__ROFI = ${JSON.stringify(ROFI)};`}></script>
<script is:inline>
  (function () {
    var overlay = document.getElementById('rofi');
    var q = document.getElementById('rofi-q');
    var list = document.getElementById('rofi-list');
    var halt = document.getElementById('halt');
    var data = window.__ROFI || [];
    var sel = 0;
    var shown = [];

    function openTweaks() { window.dispatchEvent(new CustomEvent('tweaks:toggle')); }

    /* macOS-style workspace zoom, both directions: remember where the tab
       sits (for the incoming page), shrink this page into it, navigate */
    function zoomFrom(el) {
      if (!el) return;
      var r = el.getBoundingClientRect();
      try {
        sessionStorage.setItem('gnut-zoom', JSON.stringify({
          x: r.left + r.width / 2, y: r.top + r.height / 2, t: Date.now()
        }));
      } catch (e) {}
    }
    var zooming = false;
    function zoomNav(el, href) {
      if (!el || !href) return;
      zoomFrom(el);
      if (zooming) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        location.href = href;
        return;
      }
      zooming = true;
      var html = document.documentElement;
      var r = el.getBoundingClientRect();
      var d = document.querySelector('.desktop');
      var dr = d ? d.getBoundingClientRect() : null;
      var wrap = dr ? dr.width : Math.min(1440, html.clientWidth);
      var ox = Math.min(wrap, Math.max(0, r.left + r.width / 2 - (dr ? dr.left : (html.clientWidth - wrap) / 2)));
      html.style.setProperty('--zoom-ox', ox.toFixed(0) + 'px');
      html.style.setProperty('--zoom-oy', (scrollY + r.top + r.height / 2).toFixed(0) + 'px');
      html.setAttribute('data-zoom', 'out');
      setTimeout(function () { location.href = href; }, 170);
    }
    window.gnutZoomNav = zoomNav;
    [].forEach.call(document.querySelectorAll('.bar-ws .ws-btn'), function (a) {
      a.addEventListener('click', function (e) {
        /* modified clicks (new tab etc.) keep native behavior — only the
           incoming side of the zoom applies there */
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) {
          zoomFrom(a);
          return;
        }
        e.preventDefault();
        zoomNav(a, a.getAttribute('href'));
      });
    });

    function run(item) {
      close();
      if (item.href === '!theme') { openTweaks(); return; }
      if (item.href === '!halt') { halt.classList.add('on'); return; }
      if (item.k === 'goto') {
        var wsBtn = document.querySelector('.bar-ws .ws-btn[href="' + item.href + '"]');
        if (wsBtn) { zoomNav(wsBtn, item.href); return; }
      }
      location.href = item.href;
    }
    function render() {
      var needle = q.value.trim().toLowerCase();
      shown = data.filter(function (it) {
        return !needle ||
          it.t.toLowerCase().indexOf(needle) !== -1 ||
          (it.x || '').toLowerCase().indexOf(needle) !== -1;
      });
      if (sel >= shown.length) sel = Math.max(0, shown.length - 1);
      list.innerHTML = '';
      if (!shown.length) {
        var d = document.createElement('div');
        d.className = 'rofi-empty';
        d.textContent = 'no match — try another term';
        list.appendChild(d);
        return;
      }
      shown.forEach(function (it, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'rofi-item' + (i === sel ? ' sel' : '');
        b.setAttribute('role', 'option');
        if (it.tc) b.style.setProperty('--tc', it.tc);
        b.innerHTML = '<span class="k"></span><span class="t"></span>';
        b.querySelector('.k').textContent = it.k;
        b.querySelector('.t').textContent = it.t;
        b.addEventListener('click', function () { run(it); });
        list.appendChild(b);
      });
      var cur = list.children[sel];
      if (cur && cur.scrollIntoView) cur.scrollIntoView({ block: 'nearest' });
    }
    function open() {
      overlay.classList.add('open');
      q.value = '';
      sel = 0;
      render();
      setTimeout(function () { q.focus(); }, 0);
    }
    function close() { overlay.classList.remove('open'); }

    document.getElementById('bar-menu').addEventListener('click', function (e) {
      e.stopPropagation();
      overlay.classList.contains('open') ? close() : open();
    });
    overlay.addEventListener('mousedown', function (e) {
      if (e.target === overlay) close();
    });
    q.addEventListener('input', function () { sel = 0; render(); });
    q.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(shown.length - 1, sel + 1); render(); }
      if (e.key === 'ArrowUp')   { e.preventDefault(); sel = Math.max(0, sel - 1); render(); }
      if (e.key === 'Enter' && shown[sel]) { e.preventDefault(); run(shown[sel]); }
    });
    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        overlay.classList.contains('open') ? close() : open();
      }
      if (e.key === 'Escape' && overlay.classList.contains('open')) close();
    });

    halt.addEventListener('click', function () { halt.classList.remove('on'); });
    document.getElementById('bar-conf').addEventListener('click', openTweaks);

    /* one-line clock: "9:41 PM · 07/09" — the year is on the footer */
    var clock = document.getElementById('bar-clock');
    function tick() {
      var d = new Date();
      var h = d.getHours();
      var ap = h >= 12 ? 'PM' : 'AM';
      var h12 = h % 12 || 12;
      var time = h12 + ':' + String(d.getMinutes()).padStart(2, '0') + ' ' + ap;
      var date =
        String(d.getMonth() + 1).padStart(2, '0') + '/' +
        String(d.getDate()).padStart(2, '0');
      clock.innerHTML = '<b></b><span></span>';
      clock.firstChild.textContent = time;
      clock.lastChild.textContent = '· ' + date;
    }
    tick();
    setInterval(tick, 15000);
  })();
</script>
