---
import BaseLayout from '../layouts/BaseLayout.astro';
import { OS_FULL, pageTitle } from '../data/site';
import { SKULL_FACE, HACKER_PAL, pxSvg } from '../data/pixel';
---
<BaseLayout title={pageTitle('404')} description="Page not found." activeNav="404">
  <div class="panic">
    <h1 class="sr-only">404 — page not found</h1>
    <div class="panic-row">
      <span class="panic-face" aria-hidden set:html={pxSvg(SKULL_FACE, HACKER_PAL, 160)} />
      <pre>
<span class="d">[    0.000000]</span> {OS_FULL} booting workspace…
<span class="d">[    0.000404]</span> <span class="r">Kernel panic - not syncing:</span> <span class="t">VFS: unable to mount page</span>
<span class="d">[    0.000405]</span> <span class="t">skelamton: segfault</span>
<span class="d">[    0.000406]</span>   requested: <span class="y nf-path">/unknown</span>
<span class="d">[    0.000407]</span>   status:    <span class="r">404 NOT FOUND</span> — unloaded, recycled, or never written
<span class="d">[    0.000408]</span> Call Trace:
<span class="d">[    0.000409]</span>   browse_blog+0x404/0x1000
<span class="d">[    0.000410]</span>   handle_request+0x1a/0x40
<span class="d">[    0.000411]</span>   <span class="d">? speculative_click+0x0/0x8</span>
<span class="d">[    0.000412]</span> Recovery options:
<span class="d">[    0.000413]</span>   $ <a href="/">cd ~</a>              <span class="d"># back to the main workspace</span>
<span class="d">[    0.000414]</span>   $ <a href="/posts/">ls ~/posts</a>        <span class="d"># browse every post</span>
<span class="d">[    0.000415]</span>   $ <a href="/tags/">grep -r tags/</a>     <span class="d"># search by tag</span>
<span class="d">[    0.000416]</span> <span class="g">---[ press any key / tap to reboot to ~ ]---</span><span class="caret" aria-hidden></span>
      </pre>
    </div>
  </div>
  <script is:inline>
    document.querySelectorAll('.nf-path').forEach(function (n) { n.textContent = location.pathname; });
    document.addEventListener('keydown', function (e) {
      if (['Tab','Shift','Enter','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)) return;
      if (!e.ctrlKey && !e.metaKey && !e.altKey) location.href = '/';
    });
    document.querySelector('.panic').addEventListener('click', function (e) {
      if (!e.target.closest('a')) location.href = '/';
    });
  </script>
</BaseLayout>
