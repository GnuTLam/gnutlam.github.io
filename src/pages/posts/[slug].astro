---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReaderInteractive from '../../components/islands/ReaderInteractive';
import { isPublished, toPostData, byNewest } from '../../data/posts';
import { topicOf } from '../../data/topics';
import { SITE, pageTitle } from '../../data/site';
import { resolveImages } from '../../data/images';
import type { PostData } from '../../types';

export async function getStaticPaths() {
  const entries = (await getCollection('posts')).filter(isPublished);
  const posts: PostData[] = entries.map(toPostData).sort(byNewest);

  return entries.map(entry => ({
    params: { slug: entry.id },
    props:  { entry, posts },
  }));
}

const { entry, posts } = Astro.props;
/* relative image paths → bundled URLs; the first image doubles as the share image */
const { body: source, cover } = resolveImages(entry.body ?? '', entry.id);

const post: PostData = toPostData(entry);

// sorted newest→oldest — prev = newer (earlier in array), next = older (later in array)
const idx      = posts.findIndex(p => p.slug === post.slug);
const prevPost = idx > 0             ? posts[idx - 1] : null;
const nextPost = idx < posts.length - 1 ? posts[idx + 1] : null;

// see-also: newest siblings from the same category (topicOf), never self and
// never the prev/next posts (the pager already links them)
const related = posts
  .filter(p => p.slug !== post.slug && p.slug !== prevPost?.slug && p.slug !== nextPost?.slug
    && topicOf(p.tags).key === topicOf(post.tags).key)
  .slice(0, 3);

const siteURL      = Astro.site?.href ?? SITE.url;
const canonicalURL = new URL(`/posts/${post.slug}/`, siteURL).href;
const ogImage      = new URL(cover ?? '/og-default.png', siteURL).href;
const author       = SITE.domain;

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.iso,
  dateModified: post.iso,
  author: { '@type': 'Person', name: author, url: siteURL },
  publisher: { '@type': 'Person', name: author, url: siteURL },
  keywords: post.tags.join(', '),
  mainEntityOfPage: canonicalURL,
  url: canonicalURL,
  image: ogImage,
};
---

<BaseLayout
  title={pageTitle(post.title)}
  description={post.excerpt}
  activeNav="posts"
  canonical={canonicalURL}
  image={ogImage}
  ogType="article"
  publishedTime={post.iso}
  author={author}
  tags={post.tags}
  jsonLd={blogPostingJsonLd}
>
  <ReaderInteractive
    post={post}
    source={source}
    prevPost={prevPost}
    nextPost={nextPost}
    related={related}
    client:load
  />
</BaseLayout>
