---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsShell from '../../components/islands/PostsShell';
import { isPublished, toPostData, byNewest } from '../../data/posts';
import { SITE, pageTitle } from '../../data/site';

/* first readable paragraphs of a post body, one line each — the preview
   pane renders them bat-style with line numbers (+ how many were cut) */
function peekOf(body: string): { lines: string[]; more: number } {
  const clean = body
    .replace(/```[\s\S]*?```/g, '\n')          /* code fences        */
    .replace(/^:::.*$/gm, '')                  /* callout markers    */
    .replace(/^#{1,6}\s+.*$/gm, '')            /* headings           */
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')     /* images             */
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')   /* links → text       */
    .replace(/[*_`>]/g, '');                   /* inline markers     */
  const paras = clean.split(/\n\s*\n/).map(p => p.replace(/\s+/g, ' ').trim()).filter(Boolean);
  const lines: string[] = [];
  let total = 0;
  for (const p of paras) {
    const line = p.length > 240 ? p.slice(0, 240).replace(/\s+\S*$/, '') + ' …' : p;
    lines.push(line);
    total += line.length;
    if (lines.length >= 8 || total > 900) break;
  }
  return { lines, more: Math.max(0, paras.length - lines.length) };
}

const entries = (await getCollection('posts')).filter(isPublished);
const posts = entries
  .map(e => { const pk = peekOf(e.body ?? ''); return { ...toPostData(e), peek: pk.lines, more: pk.more }; })
  .sort(byNewest);
---

<BaseLayout
  title={pageTitle('Posts')}
  description={`Browse every post on ${SITE.domain} with instant preview — systems, networks, infrastructure, and code.`}
  activeNav="posts"
>
  <PostsShell posts={posts} client:load />
</BaseLayout>
