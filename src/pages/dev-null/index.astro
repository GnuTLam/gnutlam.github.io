---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROMPT, pageTitle } from '../../data/site';
import { EMPTY_SKULL } from '../../data/empty';
---
<BaseLayout title={pageTitle('/dev/null')} description="Nothing survives here." activeNav="devnull">
  <div class="pg">
    <section class="win focus" aria-label="/dev/null">
      <header class="win-tbar">
        <span class="win-tbar-t"><b>/dev/null</b></span>
        <div class="win-status">
          <span>emptier than expected</span>
        </div>
        <span class="win-app">ls</span>
      </header>
      <div class="ph">
        <h1 class="ph-title"><span class="nowrap">/DEV/NULL<span class="caret" aria-hidden></span></span></h1>
        <p class="ph-sub">Nothing survives here.</p>
      </div>
      <div class="win-body null-body">
        <div class="null-out">
          <span class="p-empty-ico" aria-hidden set:html={EMPTY_SKULL} />
          <div>
            <p class="ph-path"><b>{PROMPT}</b>:/$ ls -la /dev/null<span class="caret" aria-hidden></span></p>
            <p class="null-total">total 0</p>
          </div>
        </div>
        <p class="null-p">
          Every deleted draft, every abandoned take, every <span class="null-rm">rm -rf</span> regret — it all ends up here.
        </p>
        <p class="null-p">
          (The ones that survived are in <a class="md-link" href="/posts/">~/posts</a>.)
        </p>
        <a class="btn pri" href="/">$ cd ~</a>
      </div>
    </section>
  </div>
</BaseLayout>
