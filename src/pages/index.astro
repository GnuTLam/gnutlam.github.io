---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeShell from '../components/islands/HomeShell';
import { getPublishedPosts } from '../data/posts';
import { SITE } from '../data/site';
import { HOME } from '../data/content';
import { checkAvatar } from '../data/avatar';

checkAvatar('home', HOME.avatar);

const posts = await getPublishedPosts();
/* the island's first render must match this prerendered HTML, so it gets the
   build date instead of reading the clock itself */
const builtOn = new Date().toISOString().slice(0, 10);

const siteURL = Astro.site?.href ?? SITE.url;
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.domain,
  url: siteURL,
  description: SITE.description,
  author: { '@type': 'Person', name: SITE.domain, url: siteURL },
};
---

<BaseLayout
  title={`${SITE.domain} — ${SITE.tagline}`}
  description={SITE.description}
  activeNav="main"
  jsonLd={websiteJsonLd}
>
  <HomeShell posts={posts} builtOn={builtOn} client:idle />
</BaseLayout>
