---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FolderCard from '../../components/static/FolderCard.astro';
import FileCard from '../../components/static/FileCard.astro';
import { topicOf } from '../../data/topics';
import { getPublishedPosts, categoriesWithPosts, readMinutes, tagCounts } from '../../data/posts';
import { pageTitle } from '../../data/site';

export async function getStaticPaths() {
  const cats = categoriesWithPosts(await getPublishedPosts());
  /* the tree lists every sibling folder, with the current one expanded */
  const siblings = cats.map(c => ({ key: c.key, tone: c.tone, desc: c.desc, count: c.matches.length }));
  return cats.map(t => ({ params: { key: t.key }, props: { cat: t, posts: t.matches, siblings } }));
}

const { cat, posts, siblings } = Astro.props;
const mins = readMinutes(posts);
/* the caret rides the last word so it can never wrap onto a line of its own */
const cut = cat.title.lastIndexOf(' ') + 1;
const titleLead = cat.title.slice(0, cut);
const titleTail = cat.title.slice(cut);

/* tags actually used by posts in this category, with counts */
const usedTags = [...tagCounts(posts).entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title={pageTitle(cat.title, 'Categories')}
  description={`${cat.desc} — ${posts.length} posts in the ${cat.title.toLowerCase()} category.`}
  activeNav="categories"
>
  <div class="pg">
  <section class="win focus" aria-label={cat.title} style={`--tc: ${cat.tone}; --cv: ${cat.tone}`}>
    <header class="win-tbar">
      <span class="win-tbar-t"><b>~/categories/{cat.key}</b></span>
      <div class="win-status">
        <span><b>{posts.length}</b> {posts.length === 1 ? 'file' : 'files'} · du -h: {mins} min</span>
      </div>
      <span class="win-app">nautilus</span>
    </header>

    <div class="ph">
      <h1 class="ph-title" style={`--cv: ${cat.tone}`}>
        {titleLead}<span class="nowrap">{titleTail}<span class="caret" aria-hidden></span></span>
      </h1>
      <p class="ph-sub">{cat.desc}</p>
    </div>

    <div class="fm">
      <!-- the same vertical tree as the categories window: "../" on top,
           every sibling folder as a bar, and the current one expanded with
           its contents right below it -->
      <div class="fm-tree">
        <FolderCard class="fm-up" href="/categories/" name="../" desc="back to all categories" />
        {siblings.map(s => (
          <div class="fm-node">
            <FolderCard
              href={`/categories/${s.key}/`}
              name={`${s.key}/`}
              count={`${s.count}`}
              desc={s.desc}
              tone={s.tone}
              aria-current={s.key === cat.key ? 'page' : undefined}
            />
            {s.key === cat.key && (
              <div class="fm-panel">
                <div class="fm-files">
                  {posts.map(p => <FileCard post={p} />)}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="rel">
        <span>tags in here:</span>
        {usedTags.map(([tag]) => (
          <a class="tagchip" href={`/tags/${tag}/`} style={`--tc: ${topicOf([tag]).tone}`}>
            <b>#{tag}</b>
          </a>
        ))}
      </div>
    </div>

  </section>
  </div>
</BaseLayout>
